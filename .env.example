# FPT AI Marketplace (OpenAI-compatible)
# Docs: https://ai-docs.fptcloud.com/fpt-ai-inference/fpt-ai-inference/code-agents-with-fpt-serverless-inference-cloud-api
FPT_BASE_URL=https://mkp-api.fptcloud.com/v1
FPT_API_KEY=your-api-key-here
MAX_SESSION_TOKENS=2000

# Dùng model instruct (trả lời trực tiếp). Các model reasoning như
# Qwen3.6-27B / DeepSeek-V4-Flash / GLM-5.2 đốt hết token vào phần suy luận
# nội bộ nên với budget 2000 token sẽ không kịp trả lời.
FPT_MODEL=Llama-3.3-70B-Instruct
FPT_FALLBACK_MODEL=gemma-4-31B-it
